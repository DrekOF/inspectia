{#
  Nombre: api.test.js.j2
  Descripción: Plantilla de la prueba generada del cliente de la API de una entidad con pantalla: la ruta, el
               método y el cuerpo de cada operación del JSON, y el filtro activo del listado (RP-13, D-33).
  Fecha de creación: 26/10/2026
  Actualización: 26/10/2026
  Autor: Equipo InspectIA
  Versión: 1.0
#}
{% from 'frontend/_macros.j2' import encabezado %}
{% set con_registro = 'ver' in operaciones or 'editar' in operaciones or 'desactivar' in operaciones or 'reactivar' in operaciones %}
{{ encabezado(header) }}
import { http, HttpResponse } from 'msw';
import { describe, expect, it } from 'vitest';
import { crearCliente } from '../../api/cliente.js';
import { servidor } from '../../pruebas/servidor.js';
import * as api from './{{ var }}Api.js';

/** El cliente de la API, con una sesión de prueba: estas pruebas solo miran lo que pide. */
const pedir = crearCliente({ token: () => 'token-de-prueba', idioma: () => 'es', alCerrarSesion: () => {} });
{% if con_registro %}

/** Un identificador de ejemplo, como los de la API. */
const ID = '0199e2a0-0000-7000-8000-0000000000a1';
{% endif %}

/**
 * Atiende cualquier petición a la API y anota su método, su ruta y su cuerpo.
 *
 * @returns {Array<{ metodo: string, ruta: string, cuerpo: object|null }>} las peticiones, en orden
 */
function anotarPeticiones() {
  const peticiones = [];
  servidor.use(http.all('/api/v1/*', async ({ request }) => {
    const direccion = new URL(request.url);
    const texto = await request.text();
    peticiones.push({ metodo: request.method, ruta: direccion.pathname + direccion.search,
      cuerpo: texto ? JSON.parse(texto) : null });
    return HttpResponse.json({});
  }));
  return peticiones;
}

describe('cliente de la API de {{ entidad }} (generado)', () => {
  it('{{ ficha }} · el cliente de la API de {{ entidad }} usa la ruta y el método de cada operación del JSON', async () => {
    const peticiones = anotarPeticiones();

{% if 'listar' in operaciones %}
    await api.listar(pedir);
{% endif %}
{% if 'ver' in operaciones %}
    await api.ver(pedir, ID);
{% endif %}
{% if 'crear' in operaciones %}
    await api.crear(pedir, { dato: 'nuevo' });
{% endif %}
{% if 'editar' in operaciones %}
    await api.editar(pedir, ID, { dato: 'editado' });
{% endif %}
{% if 'desactivar' in operaciones %}
    await api.desactivar(pedir, ID);
{% endif %}
{% if 'reactivar' in operaciones %}
    await api.reactivar(pedir, ID);
{% endif %}

    expect(peticiones).toEqual([
{% if 'listar' in operaciones %}
      { metodo: 'GET', ruta: '/api/v1{{ ruta }}?pagina=0&tamano=20', cuerpo: null },
{% endif %}
{% if 'ver' in operaciones %}
      { metodo: 'GET', ruta: `/api/v1{{ ruta }}/${ID}`, cuerpo: null },
{% endif %}
{% if 'crear' in operaciones %}
      { metodo: 'POST', ruta: '/api/v1{{ ruta }}', cuerpo: { dato: 'nuevo' } },
{% endif %}
{% if 'editar' in operaciones %}
      { metodo: 'PUT', ruta: `/api/v1{{ ruta }}/${ID}`, cuerpo: { dato: 'editado' } },
{% endif %}
{% if 'desactivar' in operaciones %}
      { metodo: 'POST', ruta: `/api/v1{{ ruta }}/${ID}/desactivar`, cuerpo: null },
{% endif %}
{% if 'reactivar' in operaciones %}
      { metodo: 'POST', ruta: `/api/v1{{ ruta }}/${ID}/reactivar`, cuerpo: null },
{% endif %}
    ]);
  });
{% if tiene_activo and 'listar' in operaciones %}

  it('{{ ficha }} · el listado de {{ entidad }} pide la página, el tamaño y, si se pide, el filtro activo (D-33)', async () => {
    const peticiones = anotarPeticiones();

    await api.listar(pedir, { pagina: 2, tamano: 50, activo: false });
    await api.listar(pedir, { activo: true });

    expect(peticiones.map(({ ruta }) => ruta)).toEqual([
      '/api/v1{{ ruta }}?pagina=2&tamano=50&activo=false',
      '/api/v1{{ ruta }}?pagina=0&tamano=20&activo=true',
    ]);
  });
{% endif %}
});
