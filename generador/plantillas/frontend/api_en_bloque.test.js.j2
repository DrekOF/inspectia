{% endif %}
{% if 'editar' in operaciones %}
    await api.editar(pedir, [{ dato: 'editado' }]);
{% endif %}
{% if 'restaurar_por_defecto' in operaciones %}
    await api.restaurarPorDefecto(pedir);
{% endif %}

    expect(peticiones).toEqual([
{% if 'listar' in operaciones %}
      { metodo: 'GET', ruta: '/api/v1{{ ruta }}', cuerpo: null },
{% endif %}
{% if 'editar' in operaciones %}
      { metodo: 'PUT', ruta: '/api/v1{{ ruta }}', cuerpo: { filas: [{ dato: 'editado' }] } },
{% endif %}
{% if 'restaurar_por_defecto' in operaciones %}
      { metodo: 'POST', ruta: '/api/v1{{ ruta }}/restaurar-por-defecto', cuerpo: null },
{% endif %}
    ]);
  });
});
