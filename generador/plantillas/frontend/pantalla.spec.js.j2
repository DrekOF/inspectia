{#
  Nombre: pantalla.spec.js.j2
  Descripción: Plantilla de la prueba generada de punta a punta (Playwright) de la pantalla de una entidad, en el
               entorno aislado: quién la abre (RNF-04), sus fallas de accesibilidad (RNF-06 C4) y que quepa en
               el ancho de un celular (RNF-05 C1).
  Fecha de creación: 26/10/2026
  Actualización: 26/10/2026
  Autor: Equipo InspectIA
  Versión: 1.0
#}
{% from 'frontend/_macros.j2' import encabezado %}
{% set p = prueba %}
{{ encabezado(header) }}
import AxeBuilder from '@axe-core/playwright';
import { expect, iniciarSesion, personaDelRol, test } from '../ayudas.js';

/** La pantalla en la app. */
const RUTA = '{{ ruta }}';

/** Las pautas WCAG que revisa axe (RNF-06 C4). */
const PAUTAS = ['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa'];

/**
 * Abre la pantalla, con la sesión ya iniciada, y espera a que termine de cargar su lista.
 *
 * @param {import('@playwright/test').Page} page la página
 */
async function abrirPantalla(page) {
  await page.goto(RUTA);
  await expect(page.getByRole('heading', { name: {{ titulo_es | js }}, level: 1 })).toBeVisible();
  await expect(page.getByRole('progressbar')).toHaveCount(0);
}
{% for rol in operaciones.listar %}

test('RNF-04 · la pantalla de {{ entidad }} la abre {{ rol }}, uno de los roles de listar (de punta a punta)', async ({ page }) => {
  await iniciarSesion(page, personaDelRol('{{ rol }}'));
  await abrirPantalla(page);
});
{% endfor %}
{% for rol in p.roles_sin_permiso %}

test('RNF-04 · la pantalla de {{ entidad }} no la abre {{ rol }}, que no está en los roles de listar (de punta a punta)', async ({ page }) => {
  await iniciarSesion(page, personaDelRol('{{ rol }}'));
  await page.goto(RUTA);
  await expect(page.getByRole('heading', { name: 'Sin permiso', level: 1 })).toBeVisible();
});
{% endfor %}

test('RNF-06 · C4 · la pantalla de {{ entidad }} no tiene fallas de accesibilidad WCAG AA, ni en el tema claro ni en el oscuro', async ({ page }) => {
  await iniciarSesion(page, personaDelRol('{{ p.rol }}'));
  for (const esquema of ['light', 'dark']) {
    await page.emulateMedia({ colorScheme: esquema });
    await abrirPantalla(page);
    const resultado = await new AxeBuilder({ page }).withTags(PAUTAS).analyze();
    expect(resultado.violations.map((falla) => `${falla.id}: ${falla.help}`), esquema).toEqual([]);
  }
});

test('RNF-05 · C1 · la pantalla de {{ entidad }} no se desplaza a los lados desde 360 px de ancho', async ({ page }) => {
  await page.setViewportSize({ width: 360, height: 740 });
  await iniciarSesion(page, personaDelRol('{{ p.rol }}'));
  await abrirPantalla(page);
  const { contenido, ventana } = await page.evaluate(() => ({
    contenido: document.documentElement.scrollWidth, ventana: document.documentElement.clientWidth }));
  expect(contenido).toBeLessThanOrEqual(ventana);
});
