{#
  Nombre: repositorio.java.j2
  Descripción: Plantilla del repositorio de Spring Data JPA de una tabla con CRUD (RP-23). En una entidad
               con edición en bloque, lee las filas de una empresa todas juntas y las bloquea para
               editarlas.
  Fecha de creación: 13/10/2026
  Actualización: 20/10/2026
  Autor: Equipo InspectIA
  Versión: 1.2
#}
{% from 'java/_macros.j2' import encabezado %}
{{ encabezado(header) }}
package {{ paquete }};

{% for i in importaciones %}
import {{ i }};
{% endfor %}

/**
 * Repositorio de la tabla {@code {{ entidad }}}.
{% if consultas %}
 *
 * <p>Las consultas {@code existe...} revisan los datos únicos antes de guardar, para responder 409 con
 * el campo repetido. El índice único de la base es la última defensa.
{% endif %}
 */
public interface {{ clase }}Repositorio extends JpaRepository<{{ clase }}, UUID> {
{% for c in consultas %}

    /**
     * Dice si ya hay un registro con este valor de {{ c.etiqueta }}{{ ', sin distinguir mayúsculas ni espacios al inicio o al final' if c.normalizado else '' }}.
     *
     * @param valor el valor que se quiere guardar
     * @return {@code true} si ya existe
     */
    @Query("{{ c.jpql }}")
    boolean {{ c.metodo }}(@Param("valor") {{ c.tipo }} valor);

    /**
     * Dice si otro registro, distinto de {@code id}, ya tiene este valor de {{ c.etiqueta }}. Sirve al editar.
     *
     * @param valor el valor que se quiere guardar
     * @param id el registro que se edita
     * @return {@code true} si otro registro ya lo tiene
     */
    @Query("{{ c.jpql_en_otro }}")
    boolean {{ c.metodo_en_otro }}(@Param("valor") {{ c.tipo }} valor, @Param("id") UUID id);
{% endfor %}
{% if en_bloque %}

    /**
     * Las filas de una empresa, sin un orden fijo: la API nunca lista las de otra (RNF-03).
     *
     * @param empresaId la empresa de la sesión
     * @return las filas
     */
    List<{{ clase }}> findAllByEmpresaId(UUID empresaId);

    /**
     * Las filas de una empresa, bloqueadas hasta que termine la transacción ({@code SELECT … FOR UPDATE}).
     * Si otra transacción las está cambiando, espera a que termine y las lee como quedaron: así dos
     * ediciones a la vez no mezclan sus filas.
     *
     * <p>Solo sirve dentro de la transacción que después guarda, así que exige una: fuera de ella, el
     * bloqueo se soltaría al instante.
     *
     * @param empresaId la empresa de la sesión
     * @return las filas
     */
    @Transactional(propagation = Propagation.MANDATORY)
    @Lock(LockModeType.PESSIMISTIC_WRITE)
    @Query("select e from {{ clase }} e where e.empresaId = :empresaId")
    List<{{ clase }}> bloquearLasDeLaEmpresa(@Param("empresaId") UUID empresaId);
{% elif con_empresa %}

    /**
     * Una página de los registros de una empresa: la API nunca lista los de otra (RNF-03).
     *
     * @param empresaId la empresa de la sesión
     * @param pagina la página que se pide
     * @return la página
     */
    Page<{{ clase }}> findAllByEmpresaId(UUID empresaId, Pageable pagina);

    /**
     * Un registro de una empresa: si es de otra, la API responde que no existe (RNF-03).
     *
     * @param id el registro
     * @param empresaId la empresa de la sesión
     * @return el registro, si existe y es de esa empresa
     */
    Optional<{{ clase }}> findByIdAndEmpresaId(UUID id, UUID empresaId);
{% endif %}
}
