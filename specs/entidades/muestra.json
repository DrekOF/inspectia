  "unicos": [
    {
      "atributos": ["lote_id", "numero"],
      "fichas": ["D-25"]
    }
  ],
  "checks": [
    {
      "nombre": "muestra_terminada_completa",
      "sql": "estado <> 'TERMINADA' OR num_nonnulls(modelo_id, total_granos, granos_sanos, aviso_confianza_baja, umbral_confianza_baja, porcentaje_max_dudosos, fecha_fin) = 7",
      "descripcion": "Una muestra terminada tiene sus conteos, su modelo, el aviso, la copia de los parámetros y la fecha de fin.",
      "fichas": ["RF-08", "RF-09", "RF-10"]
    },
    {
      "nombre": "muestra_fechas_segun_estado",
      "sql": "(estado = 'PENDIENTE' OR fecha_envio IS NOT NULL) AND (estado NOT IN ('EN_PROCESO', 'TERMINADA') OR fecha_inicio IS NOT NULL)",
      "descripcion": "Una muestra enviada tiene fecha de envío; una en proceso o terminada, también fecha de inicio.",
      "fichas": ["RNF-01", "RNF-02"]
    },
    {
      "nombre": "muestra_sanos_no_superan_total",
      "sql": "granos_sanos IS NULL OR granos_sanos <= total_granos",
      "descripcion": "Los granos sanos no pueden ser más que el total.",
      "fichas": ["RF-10"]
    }
  ]
