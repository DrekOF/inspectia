{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IniciarSesionEnEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "BajarImagenes",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:us-east-1:<cuenta>:repository/inspectia/*"
    },
    {
      "Sid": "ListarArchivos",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::inspectia-archivos-<cuenta>"
    },
    {
      "Sid": "FotosYReportes",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::inspectia-archivos-<cuenta>/fotos/*",
        "arn:aws:s3:::inspectia-archivos-<cuenta>/reportes/*"
      ]
    },
    {
      "Sid": "LeerModelos",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::inspectia-archivos-<cuenta>/modelos/*"
    },
    {
      "Sid": "RespaldosSinBorrar",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::inspectia-archivos-<cuenta>/respaldos/*"
    },
    {
      "Sid": "LeerSecretos",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:us-east-1:<cuenta>:parameter/inspectia/jwt-clave",
        "arn:aws:ssm:us-east-1:<cuenta>:parameter/inspectia/postgres-contrasena"
      ]
    },
    {
      "Sid": "DescifrarSecretosConLaLlaveDeSsm",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:<cuenta>:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "RegistrosEnCloudWatch",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents",
        "logs:PutRetentionPolicy"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:<cuenta>:log-group:/inspectia/*",
        "arn:aws:logs:us-east-1:<cuenta>:log-group:/inspectia/*:log-stream:*"
      ]
    },
    {
      "Sid": "ConsultarGruposDeRegistros",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "arn:aws:logs:us-east-1:<cuenta>:log-group:*"
    },
    {
      "Sid": "MetricasDelAgente",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "CWAgent"
        }
      }
    },
    {
      "Sid": "AvisarSiFallaElRespaldo",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:<cuenta>:inspectia-alertas"
    }
  ]
}
