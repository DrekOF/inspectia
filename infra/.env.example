# Nombre: .env.example
# Descripción: Variables de la base de datos local de InspectIA. Copia este archivo a infra/.env,
#              que no se sube al repositorio, y escribe tu contraseña.
# Fecha de creación: 12/10/2026
# Actualización: 12/10/2026
# Autor: Equipo InspectIA
# Versión: 1.0

POSTGRES_DB=inspectia
POSTGRES_USER=inspectia
# Obligatoria: elige una propia. No la compartas ni la subas al repositorio.
POSTGRES_PASSWORD=
# Cambia el puerto si ya tienes otro PostgreSQL usando el 5432.
POSTGRES_PORT=5432
