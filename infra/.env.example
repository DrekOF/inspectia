# Nombre: .env.example
# Descripción: Variables locales de InspectIA: la base de datos, la clave de los tokens del inicio
#              de sesión, la carpeta de las fotos y el primer administrador de la plataforma. Copia este
#              archivo a infra/.env, que no se sube al repositorio, y escribe tus valores.
# Fecha de creación: 12/10/2026
# Actualización: 23/11/2026
# Autor: Equipo InspectIA
# Versión: 1.5

POSTGRES_DB=inspectia
POSTGRES_USER=inspectia
# Obligatoria: elige una propia. No la compartas ni la subas al repositorio.
# Usa solo letras sin tildes, números y los símbolos - _ . @ % + *: la leen docker compose y el
# backend, y cada uno interpreta distinto $, #, \, las comillas, los espacios, las tildes y la eñe.
POSTGRES_PASSWORD=
# Cambia el puerto si el 5432 está ocupado o si Windows lo tiene reservado (ver README), por ejemplo a 5433.
POSTGRES_PORT=5432

# Clave de los tokens del inicio de sesión (D-28). Obligatoria: sin ella, el backend no arranca.
# Son 32 bytes al azar en Base64. Créala una vez con uno de estos comandos y pega el resultado:
#   Git Bash, Linux o macOS: openssl rand -base64 32
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# No la compartas ni la subas al repositorio. Si cambia, las sesiones abiertas dejan de servir.
INSPECTIA_JWT_CLAVE=

# Carpeta de las fotos de las muestras en tu PC (RF-05, D-41). Opcional: sin esta línea, las fotos van a
# <tu carpeta de usuario>/.inspectia/fotos. Si la cambias, que quede fuera del repositorio. Escribe la ruta
# completa con «/», también en Windows, y sin tildes: este archivo convierte las «\» (C:\fotos sería otra
# ruta). Si reinicias la base de datos, borra también esta carpeta.
# INSPECTIA_FOTOS_CARPETA=C:/Users/tu-usuario/fotos-inspectia

# Cuánto tarda el clasificador falso en responder, mientras no esté el servicio de IA (RF-10). Opcional:
# sin esta línea responde de una vez. Con unos segundos se ve la espera en la página del resultado.
# INSPECTIA_IA_FALSO_DEMORA=3s

# Primer administrador de la plataforma (RF-01). Los lee infra/bd/crear-admin-plataforma.sh o .ps1
# (ver infra/README.md). La contraseña tiene de 8 a 64 caracteres y máximo 72 bytes: cada tilde o eñe
# ocupa 2. Escríbela entre comillas simples, INSPECTIA_ADMIN_CONTRASENA='tu contraseña', para que
# docker compose no interprete $ ni #. Cuando el administrador exista, bórrala de aquí.
INSPECTIA_ADMIN_NOMBRE=
INSPECTIA_ADMIN_CORREO=
INSPECTIA_ADMIN_CONTRASENA=
