# Nombre: .gitignore (frontend)
# Descripción: Lo que el frontend genera al compilar, al probar y en la demostración de otra temática, y que no va
#              al repositorio.
# Fecha de creación: 20/10/2026
# Actualización: 28/10/2026
# Autor: Equipo InspectIA
# Versión: 1.1

node_modules/
dist/

# Reportes de las pruebas: cobertura, Playwright y mutación (Stryker)
coverage/
test-results/
playwright-report/
blob-report/
reports/
.stryker-tmp/

# Entorno aislado de las pruebas de punta a punta: usuarios y contraseñas de cada corrida (datos.json),
# sus registros y la copia del backend que compila
e2e/.entorno/

# Demostración de otra temática (npm run demo:otra-tematica): la copia del proyecto con producto, sus registros y
# los datos de cada corrida
.demostracion/
